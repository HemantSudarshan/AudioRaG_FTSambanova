# ===================================
# AudioRAG Enterprise - Environment Variables
# ===================================
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development
DEBUG=true

# ===================================
# Required API Keys
# ===================================

# AssemblyAI - Transcription Service
# Get your key at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# SambaNova - LLM Provider
# Get your key at: https://sambanova.ai/
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# OpenAI - Fallback LLM (optional)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=

# ===================================
# Vector Database (Qdrant)
# ===================================

# Local Qdrant (default)
QDRANT_URL=http://localhost:6333

# Qdrant Cloud (optional)
# QDRANT_API_KEY=your_qdrant_cloud_api_key

# ===================================
# Database (PostgreSQL)
# ===================================

# SQLite for development (default)
DATABASE_URL=sqlite:///./audiorag.db

# PostgreSQL for production
# DATABASE_URL=postgresql://user:password@localhost:5432/audiorag

# ===================================
# Cache (Redis)
# ===================================

# Local Redis
REDIS_URL=redis://localhost:6379

# ===================================
# Security
# ===================================

# Secret key for JWT signing (CHANGE IN PRODUCTION!)
SECRET_KEY=change-me-to-a-secure-random-string-in-production

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ===================================
# Monitoring (optional)
# ===================================

# Sentry for error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Logging
LOG_LEVEL=INFO
LOG_FILE=rag_audio.log

# ===================================
# Model Configuration
# ===================================

# LLM Model
LLM_MODEL=Meta-Llama-3.1-405B-Instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# Embedding Model
EMBED_MODEL_NAME=BAAI/bge-large-en-v1.5
VECTOR_DIM=1024

# ===================================
# Audio Processing
# ===================================

MAX_FILE_SIZE_MB=50
SUPPORTED_FORMATS=mp3,wav,m4a

# ===================================
# Rate Limiting
# ===================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
